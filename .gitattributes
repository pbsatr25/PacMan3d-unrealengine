# ==========================================================
#  Unreal Engine 5 - .gitattributes (Git LFS)
# ==========================================================

# Normalisasi line ending untuk file teks
* text=auto

# File teks yang selalu memakai CRLF (Windows / Unreal)
*.ini       text eol=crlf
*.uproject  text eol=crlf
*.uplugin   text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.cs        text eol=crlf
*.h         text
*.cpp       text
*.inl       text
*.md        text
*.txt       text
*.json      text
*.sh        text eol=lf

# --- Aset Unreal (binary, bisa di-lock agar tidak konflik) ---
*.uasset    filter=lfs diff=lfs merge=lfs -text lockable
*.umap      filter=lfs diff=lfs merge=lfs -text lockable

# --- Gambar / tekstur ---
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
